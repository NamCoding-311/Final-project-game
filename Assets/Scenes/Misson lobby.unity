  sectors:
  - sectorIndex: 1
    sectorCode: SECTOR 01
    sectorName: HIGHWAY OUTSKIRTS
    sceneToLoad: map1
    threatLevel: 2
    targetDistance: 160
    enemyIntel: Basic Walkers, Rapid Jumpers, Heavy Chargers
    bossIntel: Outskirts Horde (10 Mutants)
    radioDispatch: 'HQ to Survivor: Outskirts highway is blocked with swarms of runners
      and jumpers. Punch through their blockade, dismount and secure Checkpoint Alpha!'
    objectives:
    - 1. Ram through barricades & reach 160m
    - 2. Dismount vehicle and eliminate 10 Zombies
    - 3. Secure forward outpost & unlock Sector 02
    rewardText: +1,500 Cash  |  Armored Truck Access
    cashReward: 1500
    sectorPreviewSprite: {fileID: 7501387830980884940, guid: 0e71d2dc98761754398416a2763774cd, type: 3}
  - sectorIndex: 2
    sectorCode: SECTOR 02
    sectorName: CONTAMINATED ZONE
    sceneToLoad: map2
    threatLevel: 4
    targetDistance: 350
    enemyIntel: Acid-Infused Walkers, Aggressive Chargers
    bossIntel: MUTATED TANK ZOMBIE (Boulder Thrower)
    radioDispatch: Hazard Alert! Toxic chemical spills detected in Sector 2. A mutated
      Tank Zombie has been sighted hurling concrete boulders. Exercise extreme caution!
    objectives:
    - 1. Traverse acid highway lanes (350m)
    - 2. Dodge flying concrete boulder strikes
    - 3. Defeat Mutated Tank Zombie on foot
    rewardText: +3,500 Cash  |  Heavy Armor Upgrade
    cashReward: 3500
    sectorPreviewSprite: {fileID: 689283645380311244, guid: a4bf339dfe6c1234f8f195cd45124d63, type: 3}
  - sectorIndex: 3
    sectorCode: SECTOR 03
